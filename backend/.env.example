# Flask
FLASK_DEBUG=True
SECRET_KEY=your-secret-key-here
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database Configuration (MySQL / SQLite)
# For MySQL:
SQLALCHEMY_DATABASE_URI=mysql+pymysql://username:password@localhost:3306/database_name
# For SQLite:
# SQLALCHEMY_DATABASE_URI=sqlite:///iats.db

SQLALCHEMY_ECHO=False
DB_POOL_RECYCLE=300

# Groq AI Configuration (Free Tier: https://console.groq.com)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

